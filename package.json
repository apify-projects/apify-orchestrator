{
    "name": "apify-orchestrator",
    "version": "0.9.0-rc.1",
    "description": "Utilities to orchestrate Apify Actors.",
    "engines": {
        "node": ">=20.0.0"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "vitest run",
        "bench:hash": "vitest --run bench hash",
        "coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "keywords": [
        "apify",
        "orchestrator",
        "actor",
        "client",
        "parallel",
        "merge",
        "pipeline",
        "task",
        "concurrent",
        "optimized"
    ],
    "author": "Marco Gullo",
    "license": "Apache-2.0",
    "type": "module",
    "devDependencies": {
        "@apify/oxlint-config": "^0.3.0",
        "@apify/tsconfig": "^0.2.0",
        "@crawlee/types": "^3.17.0",
        "@types/murmurhash-js": "^1.0.7",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "apify-cli": "^1.7.1",
        "husky": "^9.1.7",
        "murmurhash-js": "^1.0.0",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@apify/consts": "^2.54.2",
        "apify": "^3.7.2",
        "apify-client": "^2.23.4"
    },
    "cspell": {
        "version": "0.2",
        "ignorePaths": [],
        "dictionaryDefinitions": [
            {
                "name": "custom-dictionary",
                "path": "./.cspell/custom-dictionary.txt",
                "addWords": true
            }
        ],
        "dictionaries": [
            "custom-dictionary"
        ],
        "words": [],
        "ignoreWords": [],
        "import": []
    },
    "lint-staged": {
        "*.{js,ts,mjs}": [
            "oxlint",
            "oxfmt --check",
            "vitest related --run"
        ],
        "*.{json,md,yml,yaml}": [
            "oxfmt --check"
        ]
    }
}
