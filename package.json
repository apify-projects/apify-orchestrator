{
    "name": "apify-orchestrator",
    "version": "0.9.0-rc.1",
    "description": "Utilities to orchestrate Apify Actors.",
    "engines": {
        "node": ">=20.0.0"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "keywords": [
        "apify",
        "orchestrator",
        "actor",
        "client",
        "parallel",
        "merge",
        "pipeline",
        "task",
        "concurrent",
        "optimized"
    ],
    "author": "Marco Gullo",
    "license": "Apache-2.0",
    "type": "module",
    "devDependencies": {
        "@apify/eslint-config": "^1.1.0",
        "@apify/tsconfig": "^0.1.1",
        "@crawlee/types": "^3.16.0",
        "@vitest/coverage-v8": "^4.1.2",
        "apify-cli": "^1.4.1",
        "axios": "^1.14.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.2"
    },
    "dependencies": {
        "@apify/consts": "^2.52.1",
        "apify": "^3.7.0",
        "apify-client": "^2.22.3"
    },
    "cspell": {
        "version": "0.2",
        "ignorePaths": [],
        "dictionaryDefinitions": [
            {
                "name": "custom-dictionary",
                "path": "./.cspell/custom-dictionary.txt",
                "addWords": true
            }
        ],
        "dictionaries": [
            "custom-dictionary"
        ],
        "words": [],
        "ignoreWords": [],
        "import": []
    },
    "lint-staged": {
        "*.{js,ts,mjs}": [
            "eslint",
            "prettier --check",
            "vitest related --run --config vitest.unit.config.ts"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --check"
        ]
    }
}
